{
  "name": "@dommaker/harness",
  "version": "0.18.0",
  "description": "通用工程约束框架 - 铁律系统、检查点验证、测试门控、拦截器",
  "keywords": [
    "harness",
    "constraint",
    "iron-law",
    "quality-gate",
    "engineering"
  ],
  "author": "kww",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "harness": "./bin/harness.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "require": "./dist/core/index.js",
      "import": "./dist/core/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "require": "./dist/presets/index.js",
      "import": "./dist/presets/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "require": "./dist/context/index.js",
      "import": "./dist/context/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "src",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && cp -r src/tools/definitions dist/tools/definitions",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src",
    "hooks:install": "bash bin/install-precommit-hook.sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.3",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dommaker/harness.git"
  },
  "bugs": {
    "url": "https://github.com/dommaker/harness/issues"
  },
  "homepage": "https://github.com/dommaker/harness#readme"
}
